# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LinkedIn OAuth credentials (Optional, falls back to sandbox simulator if not set)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ENABLE_CLAUDE_CLI_PROVIDER: LOCAL DEVELOPMENT ONLY. Set to "true" to allow
# selecting "Claude Code CLI (local dev only)" as an AI provider in Settings.
# Shells out to the `claude` CLI on this machine, authenticated to whatever
# subscription is logged in there -- no API key needed. Never set this in a
# deployed environment: the CLI binary won't exist there, and routing other
# users' requests through a personal subscription violates Anthropic's ToS.
ENABLE_CLAUDE_CLI_PROVIDER="false"

# ENABLE_CLAUDE_CLI_WEB_SEARCH: LOCAL DEVELOPMENT ONLY, and only meaningful when
# ENABLE_CLAUDE_CLI_PROVIDER is also "true". Lets the web-search phase of AI Job
# Search and job-URL tailoring run through the Claude Code CLI's WebSearch tool
# instead of requiring a Gemini key. This spawns `claude` with
# --permission-mode bypassPermissions (WebSearch would otherwise hang waiting
# for approval in a headless session), so it is a larger trust grant than the
# plain text provider -- opt in deliberately. Slower (~60s/search) and consumes
# Claude subscription usage (~$0.30/search). A Gemini API key is faster, cheaper,
# and also unlocks multimodal PDF parsing.
ENABLE_CLAUDE_CLI_WEB_SEARCH="false"

# Job-board API keys (all OPTIONAL — job search also works with zero keys via
# the keyless Arbeitnow feed, a company watchlist, and the AI web-search source).
# Adding these widens/deepens results. Both are free-tier signups.
# Adzuna:  https://developer.adzuna.com/  (get app_id + app_key)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# Jooble:  https://jooble.org/api/about
JOOBLE_API_KEY=""
