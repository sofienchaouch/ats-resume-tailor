# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LinkedIn OAuth credentials (Optional, falls back to sandbox simulator if not set)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ENABLE_CLAUDE_CLI_PROVIDER: LOCAL DEVELOPMENT ONLY. Set to "true" to allow
# selecting "Claude Code CLI (local dev only)" as an AI provider in Settings.
# Shells out to the `claude` CLI on this machine, authenticated to whatever
# subscription is logged in there -- no API key needed. Never set this in a
# deployed environment: the CLI binary won't exist there, and routing other
# users' requests through a personal subscription violates Anthropic's ToS.
ENABLE_CLAUDE_CLI_PROVIDER="false"
